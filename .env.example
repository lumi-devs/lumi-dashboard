# Environment configuration for Lumi Dashboard
# Copy this file to .env and adjust variables as needed.

NODE_ENV=development
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_PUBLIC_URL=http://localhost:8080

# NextAuth session/JWT encryption secret (Generate with `openssl rand -hex 32`)
DASHBOARD_SESSION_SECRET=change_me_to_a_secure_random_32_character_hex_secret

# Discord OAuth2 Application Credentials (from Discord Developer Portal)
DISCORD_OAUTH2_CLIENT_ID=your_discord_client_id
DISCORD_OAUTH2_CLIENT_SECRET=your_discord_client_secret

# Internal HTTP RPC Bridge to Lumi's apps/api process
RPC_HTTP_URL=http://127.0.0.1:8091
RPC_INTERNAL_TOKEN=change_me_to_match_lumi_rpc_internal_token

# Trusted proxy hops (set if behind reverse proxy like Caddy, Cloudflare, Traefik)
TRUSTED_PROXY_HOPS=1
