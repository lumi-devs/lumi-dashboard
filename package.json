{
  "name": "lumi-dashboard",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "description": "Web admin dashboard (Next.js App Router) for Lumi - Discord OAuth login via NextAuth.js + auto-generated config forms, served over an internal HTTP RPC bridge to Lumi's apps/api.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -H \"${DASHBOARD_HOST:-0.0.0.0}\" -p \"${DASHBOARD_PORT:-3000}\"",
    "build": "next build",
    "start": "PORT=${DASHBOARD_PORT:-3000} HOSTNAME=${DASHBOARD_HOST:-0.0.0.0} bun .next/standalone/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "@lumi/contracts": "npm:@lumi-devs/contracts@latest",
    "@lumi/observability": "npm:@lumi-devs/observability@latest",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.53.0",
    "motion": "^13.5.1",
    "next": "^16.4.0",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "^1.7.0",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "@next/eslint-plugin-next": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "discord.js": "^14.27.0",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
