{
  "name": "lumi-dashboard",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "description": "Web admin dashboard (Next.js App Router) for Lumi - Discord OAuth login via NextAuth.js + auto-generated config forms, served over an internal HTTP RPC bridge to Lumi's apps/api.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H \"${DASHBOARD_HOST:-0.0.0.0}\" -p \"${DASHBOARD_PORT:-8080}\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel"
  },
  "dependencies": {
    "@lumi/contracts": "npm:@lumi-devs/contracts@latest",
    "@lumi/observability": "npm:@lumi-devs/observability@latest",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.3",
    "@next/eslint-plugin-next": "^16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "discord.js": "^14.27.0",
    "eslint": "^10.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
